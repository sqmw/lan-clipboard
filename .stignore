# Keep Syncthing focused on source, docs, and lightweight config.

# VCS / IDE
.git/
.idea/
.vscode/

# OS noise
.DS_Store
Thumbs.db
Desktop.ini

# Frontend / packaging outputs
(?d)node_modules/
(?d)dist/
.pnpm-store/
pnpm-workspace.yaml

# Rust / Tauri generated artifacts
(?d)src-tauri/target/
(?d)src-tauri/gen/schemas/

# Logs and temp files
*.log
*.tmp
